# Copy to .env.local (gitignored) and fill in what you have. Every service is
# optional — the dashboard's setup checklist shows what is still missing.
# Never commit real keys.

# --- App ---------------------------------------------------------------------
# Public HTTPS URL that Twilio can reach (ngrok / Cloudflare tunnel / your host).
PUBLIC_BASE_URL=
# Where you open the dashboard (used for the Google OAuth redirect).
APP_URL=http://localhost:3000
# 32+ random characters. Signs call-stream tokens and encrypts OAuth tokens.
# (Generated automatically into .perrie/secret in development if empty.)
PERRIE_SECRET=
# Optional. Required to open the dashboard through a public URL; without it
# the dashboard only answers direct requests to localhost.
DASHBOARD_PASSWORD=

# =============================================================================
# VOICE STACK — the engine Perrie runs on (not "integrations")
# =============================================================================

# --- Supabase (database) -----------------------------------------------------
# Without these, a local dev store in .perrie/ is used.
SUPABASE_URL=
# Server-only secret key (sb_secret_...) or legacy service_role key.
SUPABASE_SECRET_KEY=

# --- LLM (Anthropic) ---------------------------------------------------------
ANTHROPIC_API_KEY=
PERRIE_MODEL_VOICE=claude-sonnet-5-5
PERRIE_MODEL_PLANNER=claude-opus-5-5

# --- Twilio (phone calls) ----------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number in E.164, e.g. +14155550123
TWILIO_PHONE_NUMBER=

# --- Deepgram (speech-to-text + text-to-speech) ------------------------------
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_VOICE=aura-2-thalia-en

# =============================================================================
# APP INTEGRATIONS — your apps Perrie works with (more later: Excel, GitHub…)
# =============================================================================

# --- Google (Calendar + Contacts) --------------------------------------------
# OAuth client (type "Web application"); authorised redirect URI:
#   http://localhost:3000/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# MONITORING — Bluejay scores every call and tests Perrie with simulated callers
# =============================================================================
# app.getbluejay.ai › Settings › API Keys (shown only once). Sent only as the
# X-API-Key header to Bluejay's MCP server.
BLUEJAY_API_KEY=
# Which finished calls are sent for scoring: all (phone + playground, default),
# phone (real calls only), non-owner (skip your own calls), off.
BLUEJAY_EVALUATE=all
# Perrie's own id for its Bluejay agent (default: perrie-voice).
BLUEJAY_AGENT_EXTERNAL_ID=
# Override only if Bluejay gives you a different MCP endpoint.
BLUEJAY_MCP_URL=
