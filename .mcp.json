{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
    },
    "bluejay": {
      "type": "http",
      "url": "https://api.getbluejay.ai/mcp",
      "headers": {
        "X-API-Key": "${BLUEJAY_API_KEY}"
      }
    }
  }
}
